    {
      "name": "Autenticacao (JWT)",
      "description": "Login e leitura do token. `POST /auth/login/` é pública e limitada a 5/min por IP; `GET /auth/me/` exige `Authorization: Bearer <token>`.",
      "item": [
        {
          "name": "Login admin - 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('devolve access token', () => pm.expect(body.access).to.be.a('string').and.not.empty);",
                  "pm.test('token_type e Bearer', () => pm.expect(body.token_type).to.eql('Bearer'));",
                  "pm.test('expires_in positivo', () => pm.expect(body.expires_in).to.be.above(0));",
                  "pm.test('devolve o admin', () => pm.expect(body.user.username).to.eql('admin'));",
                  "pm.test('devolve a role admin', () => pm.expect(body.user.role).to.eql('admin'));",
                  "pm.test('nunca devolve a senha', () => pm.expect(body.user).to.not.have.property('password'));",
                  "",
                  "// guarda o token para as pastas seguintes",
                  "pm.collectionVariables.set('admin_token', body.access);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"{{admin_username}}\",\n    \"password\": \"{{admin_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
