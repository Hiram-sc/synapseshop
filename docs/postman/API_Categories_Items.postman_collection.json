        {
          "name": "POST categoria com token admin - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201 ou 400 (nome ja existe)', () => pm.expect([201, 400]).to.include(pm.response.code));",
                  "",
                  "// `Category.name` e unico: na segunda execucao o POST volta 400.",
                  "// A colecao precisa guardar o id dos dois jeitos, senao as",
                  "// requisicoes seguintes ficam sem categoria para trabalhar.",
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('categoria_id', pm.response.json().id);",
                  "} else {",
                  "    pm.sendRequest({",
                  "        url: pm.variables.replaceIn(pm.collectionVariables.get('base_url') + '/api/v1/categories/?search=Livros'),",
                  "        method: 'GET',",
                  "        header: [{ key: 'Authorization', value: 'Bearer ' + pm.collectionVariables.get('admin_token') }]",
                  "    }, function (err, res) {",
                  "        pm.test('recupera o id da categoria existente', function () {",
                  "            const achado = res.json().results[0].id;",
                  "            pm.collectionVariables.set('categoria_id', achado);",
                  "            pm.expect(achado).to.be.above(0);",
                  "        });",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"name\": \"Livros\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
