# SynapseShop - exemplo de variáveis de ambiente (Aula 9)
#
# Copie para `.env` (lido automaticamente pelo Docker Compose) e ajuste.
# Nenhum valor real de produção mora neste arquivo; segredos saem do secret
# manager, nunca de um arquivo versionado.

# --- banco ----------------------------------------------------------------
POSTGRES_DB=synapseshop
POSTGRES_USER=synapseshop
POSTGRES_PASSWORD=synapseshop

# --- cache (Aula 8) -------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CACHE_ENABLED=true
CACHE_TTL_LISTA=60
CACHE_TTL_DETALHE=300

# --- JWT (Aula 7) ---------------------------------------------------------
# gerar com: openssl rand -hex 32
JWT_SIGNING_KEY=dev-only-jwt-key-troque-em-producao
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30

# --- throttling (Aula 7) --------------------------------------------------
THROTTLE_ANON_RATE=60/min
THROTTLE_USER_RATE=300/min
THROTTLE_LOGIN_RATE=5/min
THROTTLE_ADMIN_WRITE_RATE=30/min

# --- RabbitMQ (Aula 9) ----------------------------------------------------
RABBITMQ_USER=synapseshop
RABBITMQ_PASSWORD=synapseshop

# --- broker de mensageria (Aula 10) --------------------------------------
# kafka (padrão) usa o Apache Kafka; rabbitmq reativa o fluxo da Aula 9.
MENSAGERIA_BROKER=kafka

# --- Apache Kafka (Aula 10) ----------------------------------------------
# bootstrap resolvido pela rede do Compose (serviço `kafka`)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# grupo de consumo: reparte as partições entre workers escaláveis
KAFKA_GROUP_ID=synapseshop-worker
# tópicos e topologia: partições e retenção são aplicados na criação
KAFKA_TOPIC_PEDIDO_CRIADO=pedidos.pedidocriado
KAFKA_TOPIC_DLQ=pedidos.pedidocriado.dlq
KAFKA_TOPIC_PARTITIONS=3
KAFKA_DLQ_PARTITIONS=1
KAFKA_RETENTION_MS_MAIN=604800000      # 7 dias
KAFKA_RETENTION_MS_DLQ=2419200000      # 28 dias
# consumer: commit manual depois do processamento (nunca por antecipação)
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_AUTO_OFFSET_RESET=earliest
# producer: confirmação forte e retry interno
KAFKA_ACKS=all
KAFKA_RETRIES=3
KAFKA_LINGER_MS=10

# --- eventos da Aula 11 (pagamento e notificação) -------------------------
# um único evento por desfecho: PagamentoProcessado carrega dados.status
# (APROVADO|RECUSADO); NotificacaoEnviada sai do notificacao-worker
KAFKA_TOPIC_PAGAMENTO_PROCESSADO=pedidos.pagamentoprocessado
KAFKA_TOPIC_PAGAMENTO_DLQ=pedidos.pagamentoprocessado.dlq
KAFKA_TOPIC_NOTIFICACAO_ENVIADA=pedidos.notificacaoenviada
KAFKA_TOPIC_NOTIFICACAO_DLQ=pedidos.notificacaoenviada.dlq
# group do notificacao-worker: independente do KAFKA_GROUP_ID (pedido-worker)
KAFKA_GROUP_ID_NOTIFICACAO=synapseshop-notificacao-worker

# --- worker de pedidos (Aula 9) ------------------------------------------
# tentativas totais: inicial + retries (4 => backoff 250ms, 500ms, 1000ms)
PEDIDO_WORKER_MAX_TENTATIVAS=4
# base do backoff exponencial, em segundos
PEDIDO_WORKER_BACKOFF_BASE_S=0.25
# TTL da chave de idempotência no Redis, em segundos
PEDIDO_IDEMPOTENCIA_TTL_S=3600
# espera entre recriações de conexão quando o broker cai, em segundos
PEDIDO_WORKER_ESPERA_RECONEXAO_S=5
# falha proposital (fnmatch, separado por vírgula) para validar a DLQ.
# DEIXE VAZIO no ambiente final - só ligue para reproduzir o cenário
# processamento -> falha -> retry -> retry -> DLQ.
PEDIDO_WORKER_FALHA_IDEM_KEYS=
